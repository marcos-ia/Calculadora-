<!-- AUDIO BUTTON -->
<button class="audio-btn" id="audioBtn" aria-label="Activar sonido del motor">
    <svg id="iconSoundOff" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
    <svg id="iconSoundOn" viewBox="0 0 24 24" style="display:none"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
</button>

<script>

gsap.registerPlugin(ScrollTrigger);

// ===== LOADER =====
const loaderLetters = document.querySelectorAll('.loader-mark span');
const loaderFill = document.getElementById('loaderFill');
const loaderCounter = document.getElementById('loaderCounter');

loaderLetters.forEach((span, i) => {
    gsap.to(span, { y: 0, duration: 0.8, delay: 0.1 + i * 0.08, ease: 'power4.out' });
});

let loadProgress = 0;
const loadInterval = setInterval(() => {
    loadProgress += Math.random() * 15 + 5;
    if (loadProgress >= 100) {
        loadProgress = 100;
        clearInterval(loadInterval);
        setTimeout(hideLoader, 400);
    }
    loaderFill.style.width = loadProgress + '%';
    loaderCounter.textContent = String(Math.floor(loadProgress)).padStart(2, '0');
}, 150);

function hideLoader() {
    document.getElementById('loader').classList.add('done');
    initViewer();
    initScrollAnimations();
}

// ===== 360 VIEWER =====
let currentFrame = 0;
let isPlaying = true;
let autoPlayTimer = null;
const totalFrames = 8;
const frameDuration = 3000;

const frames = document.querySelectorAll('.viewer-frame');
const dataOverlays = [document.getElementById('d0'), document.getElementById('d1'), document.getElementById('d2'), document.getElementById('d3')];
const quotes = [document.getElementById('q0'), document.getElementById('q1'), document.getElementById('q2')];
const dots = document.querySelectorAll('.angle-dot');
const progressBar = document.getElementById('progressBar');
const frameCounter = document.getElementById('frameCounter');

function showFrame(index) {
    frames.forEach((f, i) => { f.classList.toggle('active', i === index); });
    dots.forEach((d, i) => d.classList.toggle('active', i === index));
    frameCounter.textContent = (index + 1) + '/' + totalFrames;

    const progress = ((index + 1) / totalFrames) * 163.36;
    progressBar.style.strokeDashoffset = 163.36 - progress;

    dataOverlays.forEach((el, i) => {
        const shouldShow = isPlaying && (index === i * 2 || index === i * 2 + 1);
        el.classList.toggle('visible', shouldShow);
    });

    quotes.forEach((el, i) => {
        el.classList.toggle('visible', isPlaying && index === i * 3);
    });

    currentFrame = index;
}

function nextFrame() { showFrame((currentFrame + 1) % totalFrames); }
function prevFrame() { showFrame((currentFrame - 1 + totalFrames) % totalFrames); }

function startAutoPlay() {
    if (autoPlayTimer) clearInterval(autoPlayTimer);
    autoPlayTimer = setInterval(nextFrame, frameDuration);
    isPlaying = true;
    updatePlayIcon();
}

function stopAutoPlay() {
    if (autoPlayTimer) clearInterval(autoPlayTimer);
    isPlaying = false;
    updatePlayIcon();
    dataOverlays.forEach(el => el.classList.remove('visible'));
    quotes.forEach(el => el.classList.remove('visible'));
}

function togglePlay() { isPlaying ? stopAutoPlay() : startAutoPlay(); }

function updatePlayIcon() {
    document.getElementById('iconPause').style.display = isPlaying ? 'block' : 'none';
    document.getElementById('iconPlay').style.display = isPlaying ? 'none' : 'block';
}

document.getElementById('btnPlay').addEventListener('click', togglePlay);
document.getElementById('btnNext').addEventListener('click', () => { stopAutoPlay(); nextFrame(); });
document.getElementById('btnPrev').addEventListener('click', () => { stopAutoPlay(); prevFrame(); });

let keyDebounce = false;
document.addEventListener('keydown', (e) => {
    if (keyDebounce) return;
    if (e.key === ' ') { e.preventDefault(); togglePlay(); keyDebounce = true; }
    else if (e.key === 'ArrowRight') { stopAutoPlay(); nextFrame(); keyDebounce = true; }
    else if (e.key === 'ArrowLeft') { stopAutoPlay(); prevFrame(); keyDebounce = true; }
    setTimeout(() => keyDebounce = false, 300);
});

// Mouse parallax
const viewerStage = document.getElementById('viewerStage');
document.querySelector('.viewer').addEventListener('mousemove', (e) => {
    const rect = e.currentTarget.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width - 0.5;
    const y = (e.clientY - rect.top) / rect.height - 0.5;
    gsap.to(viewerStage, { rotateY: x * 6, rotateX: -y * 4, duration: 0.6, ease: 'power2.out' });
});
document.querySelector('.viewer').addEventListener('mouseleave', () => {
    gsap.to(viewerStage, { rotateY: 0, rotateX: 0, duration: 0.8, ease: 'power3.out' });
});

function initViewer() {
    startAutoPlay();
    gsap.to('#scrollCue', { opacity: 1, duration: 1, delay: 2, ease: 'power2.out' });
}

// ===== SCROLL ANIMATIONS =====
function initScrollAnimations() {
    ScrollTrigger.create({
        start: 'top -100',
        onUpdate: (self) => {
            document.getElementById('nav').classList.toggle('scrolled', self.direction === 1 && self.scroll() > 100);
        }
    });

    gsap.from('.manifesto-text > *', {
        y: 60, opacity: 0, duration: 1.2, stagger: 0.15, ease: 'power4.out',
        scrollTrigger: { trigger: '.manifesto', start: 'top 70%', toggleActions: 'play none none none' }
    });
    gsap.from('.manifesto-visual', {
        x: 80, opacity: 0, duration: 1.4, ease: 'power4.out',
        scrollTrigger: { trigger: '.manifesto', start: 'top 60%', toggleActions: 'play none none none' }
    });

    gsap.from('.specs-header > *', {
        y: 40, opacity: 0, duration: 1, stagger: 0.1, ease: 'power4.out',
        scrollTrigger: { trigger: '.specs', start: 'top 75%', toggleActions: 'play none none none' }
    });
    gsap.from('.spec-card', {
        y: 60, opacity: 0, duration: 0.9, stagger: 0.12, ease: 'power4.out',
        scrollTrigger: { trigger: '.specs-track', start: 'top 80%', toggleActions: 'play none none none' }
    });

    document.querySelectorAll('.eng-row').forEach((row) => {
        const media = row.querySelector('.eng-media');
        const content = row.querySelector('.eng-content');

        gsap.from(media, {
            clipPath: 'inset(0 100% 0 0)', duration: 1.4, ease: 'power4.inOut',
            scrollTrigger: { trigger: row, start: 'top 70%', toggleActions: 'play none none none' }
        });
        gsap.from(content.children, {
            y: 50, opacity: 0, duration: 1, stagger: 0.12, ease: 'power4.out',
            scrollTrigger: { trigger: row, start: 'top 60%', toggleActions: 'play none none none' }
        });
    });

    gsap.from('.quote-block blockquote > *', {
        y: 40, opacity: 0, duration: 1.2, stagger: 0.2, ease: 'power4.out',
        scrollTrigger: { trigger: '.quote-block', start: 'top 70%', toggleActions: 'play none none none' }
    });

    gsap.from('.contact-inner > *', {
        y: 40, opacity: 0, duration: 1, stagger: 0.1, ease: 'power4.out',
        scrollTrigger: { trigger: '.contact', start: 'top 75%', toggleActions: 'play none none none' }
    });
}

// ===== AUDIO ENGINE =====
let audioCtx = null;
let engineNodes = [];
let isAudioOn = false;

function initAudio() {
    if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
}

function playEngine() {
    initAudio();
    if (isAudioOn || engineNodes.length > 0) return;

    const freqs = [65.41, 130.81, 196.22, 261.63, 327.03, 392.44];
    const gains = [0.04, 0.025, 0.015, 0.01, 0.008, 0.005];

    freqs.forEach((freq, i) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        const filter = audioCtx.createBiquadFilter();

        osc.type = i === 0 ? 'sawtooth' : 'square';
        osc.frequency.value = freq;

        filter.type = 'lowpass';
        filter.frequency.value = 600 + i * 150;
        filter.Q.value = 1.5;

        gain.gain.value = gains[i];

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        engineNodes.push({ osc, gain, filter });
    });

    const bufferSize = audioCtx.sampleRate * 2;
    const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * 0.1;
    }
    const noise = audioCtx.createBufferSource();
    noise.buffer = buffer;
    noise.loop = true;
    const noiseGain = audioCtx.createGain();
    noiseGain.gain.value = 0.01;
    const noiseFilter = audioCtx.createBiquadFilter();
    noiseFilter.type = 'bandpass';
    noiseFilter.frequency.value = 300;
    noiseFilter.Q.value = 1;

    noise.connect(noiseFilter);
    noiseFilter.connect(noiseGain);
    noiseGain.connect(audioCtx.destination);
    noise.start();
    engineNodes.push({ osc: noise, gain: noiseGain });

    isAudioOn = true;
    document.getElementById('iconSoundOn').style.display = 'block';
    document.getElementById('iconSoundOff').style.display = 'none';
    document.getElementById('audioBtn').classList.add('active');
}

function stopEngine() {
    engineNodes.forEach(({ osc, gain }) => {
        try {
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
            setTimeout(() => osc.stop(), 500);
        } catch(e) {}
    });
    engineNodes = [];
    isAudioOn = false;
    document.getElementById('iconSoundOn').style.display = 'none';
    document.getElementById('iconSoundOff').style.display = 'block';
    document.getElementById('audioBtn').classList.remove('active');
}

document.getElementById('audioBtn').addEventListener('click', () => {
    isAudioOn ? stopEngine() : playEngine();
});

document.addEventListener('click', function initAudioOnFirstClick() {
    initAudio();
    document.removeEventListener('click', initAudioOnFirstClick);
}, { once: true });

// ===== FORM =====
document.getElementById('contactForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    btn.textContent = 'Solicitud enviada';
    btn.classList.add('sent');
    setTimeout(() => {
        btn.textContent = 'Enviar solicitud';
        btn.classList.remove('sent');
        e.target.reset();
    }, 3000);
});

// ===== SMOOTH SCROLL =====
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});
</script>
</body>
